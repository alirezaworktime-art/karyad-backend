# Copy to .env for local development. Never commit the real .env.
NODE_ENV=development
PORT=3000

# Path to the maintenance catalog, relative to the project root
CATALOG_PATH=catalog/maintenance-catalog.json

# Android release info served at /api/v1/app-version
ANDROID_LATEST_VERSION=0.1.0
ANDROID_MIN_SUPPORTED_VERSION=0.1.0
# ANDROID_DOWNLOAD_URL=https://karyad.ir/download/karyad.apk

# Abuse protection: requests per client IP per minute
RATE_LIMIT_PER_MINUTE=120
# Proxies/load balancers in front of the service (for real client IPs)
TRUST_PROXY_HOPS=0
